{
  "name": "sbb-twin",
  "private": true,
  "type": "module",
  "description": "Live digital twin of every Swiss train: GTFS + GTFS-RT on real track geometry, published on MQTT, with provokable disruptions.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "vite build viewer",
    "start": "NODE_ENV=production tsx src/main.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "aedes": "^1.2.0",
    "gtfs-realtime-bindings": "^2.2.0",
    "hono": "^4.13.19",
    "lucide-react": "^1.77.0",
    "maplibre-gl": "^6.19.0",
    "mqtt": "^5.16.1",
    "mqtt-packet": "^9.0.2",
    "protobufjs": "^8.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
